# Add ONE writing-model key. If both are configured, the pipeline prefers OpenAI.
OPENAI_API_KEY=
GROQ_API_KEY=

# Gemini TTS (Google AI Studio programmatic narration). Required for `npm run narration`.
# The API key is NEVER printed, stored in source, or committed. Model and voice MUST be set
# explicitly (no guessed defaults). Example shape:
#   GEMINI_API_KEY=
#   GEMINI_TTS_MODEL=               # e.g. a model listed by Gemini TTS (see Gemini docs)
#   GEMINI_TTS_VOICE=               # e.g. a prebuilt Gemini TTS voice name
#   GEMINI_TTS_LANGUAGE=            # optional BCP-47 hint, e.g. hi-IN

# Optional publishing and music credentials. Keep all values local in .env.
ZERNIO_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
FREESOUND_REFRESH_TOKEN=

# Optional private Cloudflare R2 media hosting for in-process uploads.
# Create a private bucket and a bucket-scoped Object Read & Write token manually.
# Never commit values. Do not enable public buckets, r2.dev, or custom domains.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: default, eu, fedramp, or us. Omit for the default endpoint.
# R2_JURISDICTION=
# Optional: presigned GET lifetime in seconds (3600..604800). Default: 86400.
# R2_PRESIGN_TTL_SECONDS=86400

# Optional provider-specific model overrides.
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=openai/gpt-oss-120b

# Optional retry/backoff controls. When a provider rate limit (HTTP 429) or a
# transient 5xx/network error happens, calls retry with exponential backoff
# until the cap is reached. Defaults: 6h cap, 5s base, 300s max.
# SCRIPT_RETRY_MAX_HOURS=6
# SCRIPT_RETRY_BASE_SECONDS=5
# SCRIPT_RETRY_MAX_SECONDS=300

# Optional Google Flow retry loop controls. The Playwright runner re-runs
# pending/failed assets with backoff until everything is done or the cap is hit.
# FLOW_MAX_RETRY_HOURS=6
# FLOW_RETRY_BASE_MS=5000
# FLOW_RETRY_MAX_MS=300000

# Optional SEO repair budget. The SEO stage validates every model response and
# retries with the exact validation errors. 1 = no repair, hard max 5.
# SEO_MAX_ATTEMPTS=3
